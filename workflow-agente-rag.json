    {
      "parameters": {
        "jsCode": "// Unifica las dos fuentes (Webhook y Gmail) en un mismo esquema.\nreturn $input.all().map(item => {\n  const j = item.json;\n  const esWebhook = j.body !== undefined;\n  let canal, email, nombre, pregunta;\n  if (esWebhook) {\n    const b = j.body || {};\n    canal = 'webhook';\n    email = String(b.email || '').trim().toLowerCase();\n    nombre = String(b.nombre || '').trim();\n    pregunta = String(b.pregunta || '').trim();\n  } else {\n    canal = 'gmail';\n    const from = String(j.From || '');\n    const m = from.match(/<(.+?)>/);\n    email = (m ? m[1] : from).trim().toLowerCase();\n    nombre = from.replace(/<.*>/, '').replace(/\"/g, '').trim();\n    pregunta = String((j.Subject || '') + '. ' + (j.snippet || '')).trim();\n  }\n  // Limita el largo para evitar abusos / prompts gigantes\n  pregunta = pregunta.slice(0, 2000);\n  return { json: { canal, email, nombre, pregunta, recibido: new Date().toISOString() } };\n});"
      },
